<launch>
<!-- M3DGR (Livox Avia + D435i), live node. The node subscribes the compressed image topic itself
     (common/img_compressed), so no image_transport republish is needed. Configuration = official
     baseline (AMENDMENTS A6) + ref-R keys, see config/m3dgr_avia.yaml. -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livo)/config/m3dgr_avia.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/m3dgr_camera_pinhole.yaml" />
	</node>

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
</launch>

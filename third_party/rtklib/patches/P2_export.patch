+/* livo P2 exports (DESIGN 12.1) ---------------------------------------------
+* rtkx_prange/rtkx_varerr/rtkx_gettgd : the static prange()/varerr()/gettgd()
+* rtkx_lastsol : full estpos/estvel states behind the last pntpos() result
+*                (pos.valid/vel.valid = 0 when that stage did not succeed)
+* not reentrant, like pntpos() itself (file-scope buffers)
+*-----------------------------------------------------------------------------*/
+extern double rtkx_prange(const obsd_t *obs, const nav_t *nav,
+                          const prcopt_t *opt, double *var)
+{
+    return prange(obs,nav,opt,var);
+}
+extern double rtkx_varerr(const prcopt_t *opt, const obsd_t *obs, double el,
+                          int sys)
+{
+    return varerr(opt,obs,el,sys);
+}
+extern double rtkx_gettgd(int sat, const nav_t *nav, int type)
+{
+    return gettgd(sat,nav,type);
+}
+extern void rtkx_lastsol(rtkx_sol_t *sol)
+{
+    *sol=rtkx_out;
+}

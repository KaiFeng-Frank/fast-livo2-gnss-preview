livo patch P2 (DESIGN §12.1, RESOLVED R2-6/R2-12, AMENDMENTS A9-4) — exports of pntpos.c internals.

Purpose
  * pntpos.c end: rtkx_prange/rtkx_varerr/rtkx_gettgd wrap the static prange() (:110-191), varerr() (:51-76)
    and gettgd() (:78-94) unchanged, so U5 can reconstruct RTKLIB's pseudorange prediction (P_corr - ssat.resp).
  * estpos() (:401-470) and estvel() (:598-632) keep only the position block (sol->qr) and drop the clock
    drift x[3] of estvel; the patch copies their converged state x, the linearisation point of the last
    iteration (where ssat.resp/azel were evaluated) and the full LSQ covariance Q into file-scope buffers.
    raim_fde() (:472-547) remembers the subset it keeps; pntpos() (:646-715) publishes the state behind the
    solution it returns; rtkx_lastsol() hands it out (livo_gnss rtk::SppRef, SppRefResult x/Q).
  * rtklib.h: declarations after pntpos() and `#define RTKX_P2 1` so rtk_adapter.cpp compiles the export
    users only against a patched tree (the LIVO_RTKLIB_APPLY_PATCHES=OFF golden build has neither).
Numerics: only copies are added; no value inside pntpos() is changed (U5 PatchedPntposEqualsUnpatchedGolden).
Not reentrant (file-scope buffers), like the rest of RTKLIB's global state; livo_gnss calls it from one thread.
Generated against upstream + P1 (applied in file-name order).

--- a/src/rtklib.h
+++ b/src/rtklib.h
@@ -1873,6 +1873,32 @@
                   const prcopt_t *opt, sol_t *sol, double *azel,
                   ssat_t *ssat, char *msg);
 
+/* livo P2: exports of pntpos.c internals (static upstream). Pure additions: the
+ * static functions are wrapped unchanged and estpos()/estvel() only copy their
+ * converged state, so pntpos() results are bit-identical to the unpatched build. */
+#define RTKX_P2     1                   /* livo P2 exports are compiled in */
+#define RTKX_MAXNX  16                  /* capacity of the exported state */
+typedef struct {        /* one least-squares estimate of the last pntpos() */
+    int valid;          /* 1: converged and accepted by pntpos() */
+    int nx;             /* state size (estpos: NX=9, estvel: 4) */
+    int nv;             /* rows of the last iteration (incl. rank constraints) */
+    int ns;             /* satellites used (estpos only) */
+    double x[RTKX_MAXNX];    /* final state (after the last update) */
+    double xlin[RTKX_MAXNX]; /* linearisation point of the last iteration: */
+                             /* ssat.resp/azel were evaluated here */
+    double Q[RTKX_MAXNX*RTKX_MAXNX]; /* covariance of the last iteration (nx*nx) */
+} rtkx_est_t;
+typedef struct {        /* full states of the last pntpos() call */
+    rtkx_est_t pos;     /* estpos: x={x,y,z,dtr,glo,gal,bds,irn,qzs} (m) */
+    rtkx_est_t vel;     /* estvel: x={vx,vy,vz,ddtr} (m/s) */
+} rtkx_sol_t;
+EXPORT double rtkx_prange(const obsd_t *obs, const nav_t *nav,
+                          const prcopt_t *opt, double *var);
+EXPORT double rtkx_varerr(const prcopt_t *opt, const obsd_t *obs, double el,
+                          int sys);
+EXPORT double rtkx_gettgd(int sat, const nav_t *nav, int type);
+EXPORT void rtkx_lastsol(rtkx_sol_t *sol);
+
 /* precise positioning -------------------------------------------------------*/
 EXPORT void rtkinit(rtk_t *rtk, const prcopt_t *opt);
 EXPORT void rtkfree(rtk_t *rtk);
